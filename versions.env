# Pinned inputs for every achew-ffmpeg build. Sourced by build/*.sh and read by
# packaging/build_wheel.py, so keep it to plain KEY=value lines.

# Wheel and release version: <FFmpeg base version>.post<build number>. Bump the
# build number whenever anything in this file or configure-flags.txt changes.
PACKAGE_VERSION=9.0.2.post1

# FFmpeg release/9.0 head. It carries two libfdk-aacdec fixes that landed after
# n9.0.2 and matter for achew's constant seeking: c8595be8e6 (decoder delay)
# and b894a6f7c1 (flush on seek). Move to the n9.0.3 tag once it ships.
FFMPEG_REPO=https://github.com/FFmpeg/FFmpeg.git
FFMPEG_COMMIT=ae19868753c5bcc2044e331d7a64187e58dde619
FFMPEG_VERSION_STRING=n9.0.2-37-gae19868753

FDK_AAC_REPO=https://github.com/mstorsjo/fdk-aac.git
FDK_AAC_VERSION=3.0.0
FDK_AAC_COMMIT=a68a51aa45d86a43c7b228e3d45624af09dcdd8d

# Built from source for the static Linux and Windows binaries. macOS links the
# system libz instead.
ZLIB_VERSION=1.3.2
ZLIB_URL=https://github.com/madler/zlib/releases/download/v1.3.2/zlib-1.3.2.tar.gz
ZLIB_SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16
